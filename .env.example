# clj-contain loads this file as environment variables. Nothing here is required:
# ./scripts/dev.sh and clojure -M:test work without it.
# GALT_ENV unset starts the :local system (config/default-config.edn); dev loads config/dev-galt.edn (shared dev R2 bucket).
GALT_ENV=dev
# Database credentials. These are also the defaults, so set them only to use another database.
MIGRATUS_DATABASE=galt_dev
MIGRATUS_USER=galt
MIGRATUS_PASSWORD=galtpass
GALT_CONFIG=config/dev-galt.edn
# Unset: the migrations import the bundled geodata sample. Set: a full pg_dump to import instead.
GALT_CITIES_COUNTRIES_SQL_PATH=data/countries-states-cities-database/world.sql
BTCPAY_API_KEY=3c960a2c799b035eb1735afc80c19d69065d898e
BTCPAY_ADMIN_API_KEY=54be540833703e33305374caf2ca673ffb87f70d

BTCPAY_URL=http://btcpayserver:49392
BTCPAY_STORE_ID=GS3n9GiK9pVDUm9nYsGiko3472iJY2FvHHyCVdaLcKQQ
BTCPAY_WEBHOOK_SECRET=7c6610553e85c6a02a98313fb9fb49d7e99998b412542bc2c8b1f9c77b69293b
