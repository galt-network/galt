 :aliases
 {:repl {:extra-paths ["dev"]
         :extra-deps  {org.clojure/clojure         {:mvn/version "1.12.6"}
                       io.github.tonsky/clj-reload {:mvn/version "1.0.0"}}}
  :dev {:extra-paths ["test"]
        :override-deps {is.mad/globo {:local/root "../globo"}}
        :extra-deps {tortue/spy {:mvn/version "2.15.0"} ; https://github.com/alexanderjamesking/spy
                     ring/ring-mock {:mvn/version "0.6.2"}
                     http-kit.fake/http-kit.fake {:mvn/version "0.2.2"}
                     nubank/matcher-combinators {:mvn/version "3.11.0"}}} ; https://github.com/nubank/matcher-combinators
  :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.14"}}
          :ns-default build}
  :outdated {;; Note that it is `:deps`, not `:extra-deps`
             :deps {com.github.liquidz/antq {:mvn/version "RELEASE"}}
             :main-opts ["-m" "antq.core"]}
  :nrepl {:extra-paths ["dev" "test"]
          :extra-deps {org.clojure/clojure {:mvn/version "1.12.6"}
                       io.github.tonsky/clj-reload {:mvn/version "1.0.0"}
                       tortue/spy {:mvn/version "2.15.0"}
                       ring/ring-mock {:mvn/version "0.6.2"}
                       http-kit.fake/http-kit.fake {:mvn/version "0.2.2"}
                       nubank/matcher-combinators {:mvn/version "3.11.0"}}
          :main-opts ["-m" "nrepl.cmdline"]}
  :clj-contain {:name "galt-dev"
                :ports [{:name :app :container 8081}]
                :networks ["galt-btcpay_default"]
                :opencode-config true
                :env {:GALT_ENV "dev"
                      :APP_PORT "8081"
                      :DB_HOST "postgres"
                      :DB_PORT "5432"
                      :MIGRATUS_DATABASE "galt_dev"
                      :MIGRATUS_USER "galt"
                      :MIGRATUS_PASSWORD "galtpass"
                      :BTCPAY_URL "http://btcpayserver:49392"
                      :GALT_WEBHOOK_URL "http://galt-dev:8081/payments/btcpay-webhook"
                      }
                :mounts ["/home/madis/code/madis/galt/data/countries-states-cities-database/world.sql:/home/madis/code/madis/galt/data/countries-states-cities-database/world.sql:z"
                         "/home/madis/.local/share/clj-contain/cdp-key:/run/cdp-key:ro,z"]
                :services [{:name "postgres"
                            :image "docker.io/library/postgres:18-alpine"
                            :port 5432
                            :env {:POSTGRES_USER "galt"
                                  :POSTGRES_PASSWORD "galtpass"
                                  :POSTGRES_DB "galt_dev"}
                            :volume {:name "pg" :dest "/var/lib/postgresql"}}]}}}
