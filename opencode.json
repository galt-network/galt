{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["PROJECT_SUMMARY.md"],
  "permissions": [
    { "action": "external_directory", "resource": "~/code/madis/globo/*", "effect": "allow" },
    { "action": "read", "resource": "~/code/madis/globo/*", "effect": "allow" },
    { "action": "edit", "resource": "~/code/madis/globo/*", "effect": "allow" }
  ],
  "mcp": {
    "servers": {
      "chrome-devtools": {
        "type": "local",
        "command": ["bash", "scripts/chrome-devtools-mcp.sh"],
        "cwd": ".",
        "environment": {
          "CHROME_DEVTOOLS_MCP_NO_USAGE_STATISTICS": "1"
        },
        "timeout": {
          "startup": 60000
        }
      },
      "coolify": {
        "type": "remote",
        "url": "https://coolify.apps.mad.is/mcp",
        "oauth": false,
        "headers": {"Authorization": "Bearer {env:COOLIFY_MCP_TOKEN}"}
      },
      "itsaplan": {
        "type": "remote",
        "url": "https://itsaplan-api.apps.mad.is/mcp"
      },
      "stitch": {
        "type": "remote",
        "url": "https://stitch.googleapis.com/mcp",
        "headers": {
          "X-Goog-Api-Key": "{env:GOOGLE_STITCH_API_KEY}"
        }
      }
    }
  }
}
